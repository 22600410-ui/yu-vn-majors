{
  "name": "yu-vn-majors",
  "private": true,
  "version": "0.1.0",
  "description": "영남대학교 학과 추천·소개 사이트 (베트남 유학생용, vi/ko)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
